{
  "name": "fresherai-vscode",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --config vite.config.js --host 0.0.0.0",
    "dev:backend": "node --watch backend/server.js",
    "build": "vite build --config vite.config.js",
    "preview": "vite preview --config vite.config.js",
    "start": "node backend/server.js"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.0",
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.1",
    "ai": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^8.1.5"
  }
}
